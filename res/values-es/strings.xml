    <string name="island_failed_body">SystemUI todavía no permite que DenRecorder aparezca en la isla. Detalles: %1$s</string>
    <string name="island_denied_body">Shizuku no permitió que DenRecorder. Toque Habilitar nuevamente y elija Permitir en el cuadro de diálogo de Shizuku.</string>
