<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bkggds.denrecorder">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional Xiaomi Focus Notification permission; Xiaomi must approve it
         for this app before HyperOS will accept island notifications. -->
    <uses-permission android:name="miui.permission.USE_FOCUS_NOTIFICATION" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The floating record button stays alive while another app is recorded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The latest release is read from GitHub, and its APK downloaded. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- An update is installed from inside the app, through Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The floating drawing button, shown over other apps while recording. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- A short buzz says a recording started or stopped without a toast on
         the screen, which the recording would capture. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The display is held awake (dimmed) while a recording runs, so the
         screen sleeping does not cut the video short. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Locking the screen rotation while a recording runs. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The recordings screen lists the videos in the save folder, including
         ones the app did not create itself (a file moved there, a reinstall). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="DenRecorder"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="DenRecorder"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the quick settings tile opens the app: the system
                 looks this activity up when the tile is pressed and held. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:label="DenRecorder"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name=".CapturePromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".DrawOverlayService"
            android:exported="false" />

        <service
            android:name=".RegionPickerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating frame picker and record button over other apps" />
        </service>

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Shizuku hands its binder to the app through this provider. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.bkggds.denrecorder.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <service
            android:name=".QsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="DenRecorder"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
        <!-- Serves the downloaded APK to Android's installer. -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="com.bkggds.denrecorder.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
